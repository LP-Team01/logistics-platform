SPRING_PROFILES_ACTIVE=prod
API_DOMAIN=api.logistics-platfom.shop
SWAGGER_ENABLED=true
# 프론트엔드가 생기면 해당 HTTPS 도메인으로 교체
CORS_ALLOWED_ORIGIN_PATTERN=https://api.logistics-platfom.shop
TRACING_SAMPLING_PROBABILITY=1.0

POSTGRES_USER=logistics_admin
POSTGRES_PASSWORD=replace-with-random-secret
POSTGRES_HOST=replace-with-rds-endpoint.ap-northeast-2.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=require

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-random-secret

# Generate with: openssl rand -base64 32 | tr -d '\n'
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
INTERNAL_SERVICE_KEY=replace-with-random-secret
HUB_INTERNAL_SERVICE_KEY=replace-with-random-secret

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_CHAT_PROVIDER=none
AI_EMBEDDING_PROVIDER=none

SLACK_BOT_TOKEN=

NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-random-secret
