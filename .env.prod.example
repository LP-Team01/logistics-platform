SPRING_PROFILES_ACTIVE=prod
SWAGGER_ENABLED=true
CORS_ALLOWED_ORIGIN_PATTERN=https://your-frontend-domain.example

POSTGRES_USER=logistics
POSTGRES_PASSWORD=replace-with-random-secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=disable

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-random-secret

JWT_SECRET=replace-with-base64-encoded-32-byte-secret
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
INTERNAL_SERVICE_KEY=replace-with-random-secret
HUB_INTERNAL_SERVICE_KEY=replace-with-random-secret

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_CHAT_PROVIDER=none
AI_EMBEDDING_PROVIDER=none

SLACK_BOT_TOKEN=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-random-secret
